{
  "openapi": "3.1.0",
  "info": {
    "title": "왜저럴까 API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/games": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "List Games",
        "operationId": "list_games_v1_games_get",
        "parameters": [
          {
            "name": "game_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Game Date"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 9998,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 12,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameSnapshot"
                  },
                  "title": "Response List Games V1 Games Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/games/{game_id}": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Get Game",
        "operationId": "get_game_v1_games__game_id__get",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Game Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/seasons/{season}/games": {
      "get": {
        "tags": [
          "mental"
        ],
        "summary": "Season Games",
        "operationId": "season_games_v1_seasons__season__games_get",
        "parameters": [
          {
            "name": "season",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Season"
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Team Id"
            }
          },
          {
            "name": "game_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Game Date"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 12,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/games/{game_id}/mental": {
      "get": {
        "tags": [
          "mental"
        ],
        "summary": "Mental Report",
        "operationId": "mental_report_v1_games__game_id__mental_get",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Game Id"
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Team Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentalReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GameSnapshot": {
        "properties": {
          "game_id": {
            "type": "string",
            "pattern": "^\\d{8}[A-Z]{4}\\d$",
            "title": "Game Id"
          },
          "game_date": {
            "type": "string",
            "format": "date",
            "title": "Game Date"
          },
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "away_team_id": {
            "type": "string",
            "title": "Away Team Id"
          },
          "home_team_id": {
            "type": "string",
            "title": "Home Team Id"
          },
          "away_runs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Away Runs"
          },
          "home_runs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Home Runs"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "source": {
            "type": "string",
            "const": "kbo-public-probe",
            "title": "Source",
            "default": "kbo-public-probe"
          },
          "verification": {
            "type": "string",
            "const": "historical-response-only",
            "title": "Verification",
            "default": "historical-response-only"
          },
          "relay_line_count": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Relay Line Count"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Hash"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "game_date",
          "series_id",
          "away_team_id",
          "home_team_id",
          "away_runs",
          "home_runs",
          "collected_at",
          "relay_line_count",
          "content_hash"
        ],
        "title": "GameSnapshot"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MentalEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "inning": {
            "type": "integer",
            "title": "Inning"
          },
          "half": {
            "type": "string",
            "enum": [
              "top",
              "bottom"
            ],
            "title": "Half"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "out",
              "strikeout",
              "double_play",
              "triple_play",
              "strikeout_reached",
              "runner_advance",
              "hit",
              "walk",
              "home_run",
              "error",
              "wild_pitch",
              "passed_ball",
              "balk",
              "stolen_base",
              "caught_stealing",
              "fielders_choice",
              "hit_by_pitch",
              "sacrifice"
            ],
            "title": "Outcome"
          },
          "delta": {
            "type": "integer",
            "title": "Delta"
          },
          "score_after": {
            "type": "integer",
            "title": "Score After"
          },
          "batter_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batter Name"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "inning",
          "half",
          "outcome",
          "delta",
          "score_after"
        ],
        "title": "MentalEvent"
      },
      "MentalReport": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "incomplete",
              "missing"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "peak_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Peak Score"
          },
          "raw_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Total"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "kbo-mental-v1"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/MentalEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "computed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Computed At"
          },
          "source_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Hash"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "team_id",
          "status"
        ],
        "title": "MentalReport"
      },
      "SeasonCoverage": {
        "properties": {
          "completed": {
            "type": "integer",
            "title": "Completed"
          },
          "indexed": {
            "type": "integer",
            "title": "Indexed"
          },
          "incomplete": {
            "type": "integer",
            "title": "Incomplete"
          },
          "missing": {
            "type": "integer",
            "title": "Missing"
          }
        },
        "type": "object",
        "required": [
          "completed",
          "indexed",
          "incomplete",
          "missing"
        ],
        "title": "SeasonCoverage"
      },
      "SeasonGame": {
        "properties": {
          "game_id": {
            "type": "string",
            "pattern": "^\\d{8}[A-Z]{4}\\d$",
            "title": "Game Id"
          },
          "game_date": {
            "type": "string",
            "format": "date",
            "title": "Game Date"
          },
          "season": {
            "type": "integer",
            "title": "Season",
            "default": 2026
          },
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "away_team_id": {
            "type": "string",
            "title": "Away Team Id"
          },
          "home_team_id": {
            "type": "string",
            "title": "Home Team Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "scheduled",
              "cancelled",
              "unknown"
            ],
            "title": "Status"
          },
          "away_runs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Away Runs"
          },
          "home_runs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Runs"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          },
          "index_status": {
            "type": "string",
            "enum": [
              "ready",
              "incomplete",
              "missing"
            ],
            "title": "Index Status",
            "default": "missing"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "game_date",
          "series_id",
          "away_team_id",
          "home_team_id",
          "status"
        ],
        "title": "SeasonGame"
      },
      "SeasonResponse": {
        "properties": {
          "season": {
            "type": "integer",
            "title": "Season"
          },
          "games": {
            "items": {
              "$ref": "#/components/schemas/SeasonGame"
            },
            "type": "array",
            "title": "Games"
          },
          "coverage": {
            "$ref": "#/components/schemas/SeasonCoverage"
          }
        },
        "type": "object",
        "required": [
          "season",
          "games",
          "coverage"
        ],
        "title": "SeasonResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
